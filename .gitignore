storage/
temp/
tmp/
*.tmp
*.log
logs/
data/db/*.db
data/cache/*
data/storage/blobs/*
data/storage/temp/*

# OS & Editor Artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

